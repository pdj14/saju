# Fill in the API key, then restart Moa. This is a SERVER-only file.
MOA_HOST=0.0.0.0
MOA_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional attribution headers.
OPENROUTER_SITE_URL=http://127.0.0.1:8787
OPENROUTER_APP_NAME=Moa

# Local alternative: change MOA_LLM_PROVIDER to ollama.
MOA_MODEL=qwen3.5:9b
MOA_OLLAMA_URL=http://127.0.0.1:11434
